{
  "manifestVersion": 1,
  "id": "AITestCaseAndAcGenerator",
  "name": "AI Test Cases and AC Generator",
  "version": "1.0.29",
  "publisher": "rakeshSaharan",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "description": "An Azure DevOps extension built with React",
  "categories": ["Azure Repos", "Azure Pipelines", "Azure Boards"],
  "scopes": ["vso.work_full", "vso.project", "vso.profile"],
  "icons": {
    "default": "build/images/icon.png"
  },
  "files": [
    {
      "path": "build",
      "addressable": true
    },
    {
      "path": "views/admin-ai-dashboard-settings.html",
      "addressable": true
    },
    {
      "path": "views/admin-ai-dashboard-settings.js",
      "addressable": true
    },
    {
      "path": "views/admin-ai-dashboard-settings.css",
      "addressable": true
    },
    {
      "path": "node_modules/vss-web-extension-sdk/lib",
      "addressable": true,
      "packagePath": "lib"
    }
  ],
  "contributions": [
    {
      "id": "workItemAiDashboard",
      "type": "ms.vss-work-web.work-item-form-page",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "AI Dashboard",
        "uri": "build/index.html"
      }
    },
    {
      "id": "AiDashboardSettings",
      "type": "ms.vss-web.hub",

      "targets": ["ms.vss-web.collection-admin-hub-group"],
      "properties": {
        "name": "AI Dashboard Settings",
        "uri": "views/admin-ai-dashboard-settings.html"
      }
    }
  ]
}
